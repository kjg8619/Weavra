---
import { Image } from "astro:assets";
import appIcon from "../assets/icon.webp";
import Layout from "../layouts/Layout.astro";
import { GITHUB_REPOSITORY_URL } from "../lib/site";

const platforms = ["macOS", "Windows", "Linux", "iOS and Android"];
---

<Layout title="Get started — Weavra" description="Weavra is in development. Read the source repository for setup instructions and release availability.">
  <div class="download-page">
    <header class="download-head">
      <div class="head-inner" data-rise>
        <Image src={appIcon} alt="" width={64} height={64} format="webp" quality={90} loading="eager" />
        <h1 class="heading">Get started with Weavra</h1>
      </div>
      <p class="head-meta" data-rise>development</p>
    </header>

    <div class="platforms">
      <section class="platform-section">
        <div class="platform-header"><h2 class="platform-name">Build from source</h2></div>
        <p class="availability-note">Independent installers, automatic updates and mobile store releases are not available. Follow the repository README for prerequisites and local setup.</p>
        <a class="btn btn-primary" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">Open the Weavra source repository <span aria-hidden="true">↗</span></a>
      </section>
      <section class="platform-section" aria-labelledby="release-availability">
        <div class="platform-header"><h2 class="platform-name" id="release-availability">Release availability</h2></div>
        <div class="download-cards">
          {platforms.map((platform) => (
            <div class="download-card">
              <span class="card-text">
                <span class="card-arch">{platform}</span>
                <span class="card-format">No independent release available</span>
              </span>
            </div>
          ))}
        </div>
      </section>
      <section class="platform-section">
        <div class="platform-header"><h2 class="platform-name">Terminal</h2></div>
        <p class="availability-note">Use the source setup instructions. There is no published one-line installer or npm quick-start command for this development version.</p>
      </section>
    </div>
  </div>
</Layout>

<style>
  .download-page {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 1.5rem 4rem;
  }
  .download-head {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 9vh 1.5rem 2.5rem;
    margin-bottom: 2rem;
  }
  .head-inner { display: flex; align-items: center; gap: 1rem; }
  .heading {
    font-weight: 500;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    letter-spacing: -0.035em;
    line-height: 1.15;
  }
  .head-meta { margin-top: 1rem; font-size: 0.8rem; color: var(--fg-muted); }
  .platforms { width: 100%; max-width: 720px; display: flex; flex-direction: column; gap: 2.5rem; }
  .platform-section { display: flex; flex-direction: column; gap: 0.75rem; }
  .platform-section > a { align-self: flex-start; }
  .platform-header { padding-bottom: 0.5rem; border-bottom: 1px solid var(--border); }
  .platform-name { font-weight: 500; font-size: 1.1rem; letter-spacing: -0.01em; }
  .availability-note { color: var(--fg-muted); font-size: 0.95rem; line-height: 1.65; }
  .download-cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.5rem; }
  .download-card {
    display: flex;
    align-items: center;
    padding: 0.85rem 1rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.02);
  }
  .card-text { display: flex; flex-direction: column; gap: 0.2rem; }
  .card-arch { font-weight: 600; font-size: 0.95rem; }
  .card-format { font-size: 0.8rem; color: var(--fg-dim); }
  @media (max-width: 640px) {
    .download-page { padding: 0 1.25rem 4rem; }
    .download-head { padding: 6vh 1.25rem 2rem; }
    .head-inner { flex-direction: column; text-align: center; }
    .platforms { padding: 0 0.25rem; }
    .download-cards { grid-template-columns: 1fr; }
  }
</style>
