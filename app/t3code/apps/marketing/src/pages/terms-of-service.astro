---
import LegalPage from "../components/LegalPage.astro";
import { GITHUB_REPOSITORY_URL } from "../lib/site";
const sections = [["licenses", "Software licenses"], ["availability", "Development availability"], ["providers", "Providers and your work"]] as const;
---
<LegalPage title="License and availability — Weavra" description="License and availability information for the Weavra development project." heading="License and availability" lede="The included software licenses govern the corresponding components. This page does not create a hosted-service agreement." sections={sections}>
  <section id="licenses">
    <p class="section-number">01</p><h2>Software licenses</h2>
    <p>Read NOTICE.md and the applicable nested LICENSE and third-party notices in the <a href={GITHUB_REPOSITORY_URL}>Weavra repository</a>. Original copyright and attribution are retained. The project notice does not relicense the imported source trees.</p>
    <p>The historical T3 Tools service terms describe a separate operator. They are not renamed, adopted or represented here as an agreement with Weavra.</p>
  </section>
  <section id="availability">
    <p class="section-number">02</p><h2>Development availability</h2>
    <p>The current product version is development. Independent installers, mobile store releases, automatic product updates and hosted account services are unavailable. Follow the source repository setup instructions rather than installers for another product.</p>
    <p>Software may contain errors. Keep backups and review commands and changes before applying them. Warranty and liability provisions are those in the applicable software licenses, not newly substituted corporate service terms.</p>
  </section>
  <section id="providers">
    <p class="section-number">03</p><h2>Providers and your work</h2>
    <p>You choose the environments and providers you connect. Their terms, charges and data practices remain separate. Ensure you have permission to process the files and credentials you supply.</p>
  </section>
</LegalPage>
