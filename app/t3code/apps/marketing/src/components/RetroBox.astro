---
interface Props {
  image: string;
  alt: string;
}
const { image, alt } = Astro.props;
const nightly = image.includes("nightly");
const front = nightly ? "#192746" : "#b9d760";
const side = nightly ? "#101827" : "#608e72";
const ink = nightly ? "#eef1ff" : "#172e2a";
---

<svg viewBox="0 0 960 1200" width="960" height="1200" role="img" aria-label={alt} xmlns="http://www.w3.org/2000/svg">
  <path d="M110 180L690 100L850 185V1020L260 1120L110 1030Z" fill={side} stroke={ink} stroke-width="5" />
  <path d="M260 265L850 185V1020L260 1120Z" fill={front} stroke={ink} stroke-width="5" />
  <path d="M110 180L260 265L850 185L690 100Z" fill={front} stroke={ink} stroke-width="5" />
  <svg x="325" y="380" width="440" height="350" viewBox="0 0 128 128" aria-hidden="true">
    <path d="M15.53 37H29L42 75L55 37H70L83 75L96.53 37H110.03L90 94H76L62.5 56L49 94H35Z" fill={ink} />
  </svg>
  <text x="555" y="800" text-anchor="middle" font-family="monospace" font-size="72" font-weight="700" fill={ink}>Weavra</text>
  <text x="555" y="865" text-anchor="middle" font-family="monospace" font-size="28" fill={ink}>development</text>
  <text x="555" y="960" text-anchor="middle" font-family="monospace" font-size="21" fill={ink}>SOURCE AVAILABLE</text>
</svg>
